{
  // The engine must stay free of browser APIs so it can run in Node (simulator, tests) and, later, on a server.
  // This config checks src/engine and src/games with no DOM lib; `npm run typecheck` runs it alongside the main one.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["src/engine", "src/games"]
}
