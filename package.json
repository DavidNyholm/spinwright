{
  "name": "spinwright",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Play-money slot game: pure TypeScript engine, Monte Carlo simulator, browser UI.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:qa": "vite build --mode qa --outDir dist-qa",
    "check:build": "vite build && node scripts/verifyBuild.ts dist && vite build --mode qa --outDir dist-qa && node scripts/verifyBuild.ts dist-qa --qa",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.engine.json --noEmit",
    "sim": "node src/sim/cli.ts",
    "sounds": "node scripts/exportSounds.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "pixi.js": "^8.22.0"
  }
}
